{
  "policy": {
    "version": 4,
    "project": {
      "id": "repo-2edd8fb7db9cef529200f875-905fd3f5",
      "description": "Build and maintain the public workshop site. Scope is limited to r2, r5, r7, and r8, with metadata reads from r4 and r6. All other inventory IDs are denied by omission. Compatible native wheels are allowed; source and install-script builds require separate explicit review.",
      "grants": [
        {
          "resource": "r2",
          "actions": [
            "read",
            "write",
            "append",
            "create",
            "delete"
          ]
        },
        {
          "resource": "r4",
          "actions": [
            "read"
          ]
        },
        {
          "resource": "r5",
          "actions": [
            "read",
            "write",
            "append",
            "create",
            "delete"
          ]
        },
        {
          "resource": "r6",
          "actions": [
            "read"
          ]
        },
        {
          "resource": "r7",
          "actions": [
            "read",
            "write",
            "append",
            "create",
            "delete"
          ]
        },
        {
          "resource": "r8",
          "actions": [
            "read",
            "write",
            "append",
            "create",
            "delete"
          ]
        }
      ],
      "escalation": {
        "warn_at": 1,
        "stop_at": 3
      },
      "packages": {
        "allowed_names": [
          "pypi:six"
        ],
        "min_release_age_days": 3,
        "deny_cvss_at_or_above": 9,
        "evidence_max_age_seconds": 900,
        "allow_native_wheels": true,
        "build_packages": []
      },
      "commands": [
        {
          "id": "test",
          "argv": [
            "/usr/bin/python3",
            "-m",
            "unittest",
            "discover",
            "-s",
            "tests",
            "-v"
          ],
          "resources": [
            "r2",
            "r4",
            "r5",
            "r6",
            "r7",
            "r8"
          ],
          "timeout_seconds": 120
        },
        {
          "id": "build",
          "argv": [
            "/usr/bin/python3",
            "-m",
            "compileall",
            "-q",
            "src"
          ],
          "resources": [
            "r2",
            "r4",
            "r5",
            "r6",
            "r7",
            "r8"
          ],
          "timeout_seconds": 120
        }
      ]
    },
