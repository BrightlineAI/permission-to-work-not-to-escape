{
  "version": 1,
  "project": {
    "id": "website",
    "description": "Update the website heading and operations documentation using only ui, notes, and ops; customers, network, credentials, and arbitrary shell tools are excluded.",
    "grants": [
      {
        "resource": "notes",
        "actions": [
          "read"
        ]
      },
      {
        "resource": "ui",
        "actions": [
          "read",
          "write"
        ]
      },
      {
        "resource": "ops",
        "actions": [
          "read",
          "write",
          "append"
        ]
      }
    ],
    "escalation": {
      "warn_at": 1,
      "stop_at": 3
    }
  },
  "tasks": [
    {
      "id": "frontend",
      "description": "Read task notes and the current website heading, then update the heading.",
      "grants": [
        {
          "resource": "notes",
          "actions": [
            "read"
          ]
        },
        {
          "resource": "ui",
          "actions": [
            "read",
            "write"
          ]
        }
      ],
      "escalation": {
        "warn_at": 1,
        "stop_at": 3
      }
    },
    {
      "id": "operations",
      "description": "Read task notes and operations documentation, then update the operations documentation by writing or appending as needed.",
      "grants": [
        {
          "resource": "notes",
          "actions": [
            "read"
          ]
        },
        {
          "resource": "ops",
          "actions": [
            "read",
            "write",
            "append"
          ]
        }
      ],
      "escalation": {
        "warn_at": 1,
        "stop_at": 3
      }
    }
  ]
}
