{
  "version": 1,
  "project": {
    "id": "website",
    "description": "Update the website heading and operations documentation. Access to customers, network, credentials, and arbitrary shell tools is excluded.",
    "grants": [
      {
        "resource": "notes",
        "actions": [
          "read"
        ]
      },
      {
        "resource": "ui",
        "actions": [
          "read",
          "write"
        ]
      },
      {
        "resource": "ops",
        "actions": [
          "read",
          "write"
        ]
      }
    ],
    "escalation": {
      "warn_at": 1,
      "stop_at": 3
    }
  },
  "tasks": [
    {
      "id": "frontend",
      "description": "Read task notes and the existing website heading, then update the heading.",
      "grants": [
        {
          "resource": "notes",
          "actions": [
            "read"
          ]
        },
        {
          "resource": "ui",
          "actions": [
            "read",
            "write"
          ]
        }
      ],
      "escalation": {
        "warn_at": 1,
        "stop_at": 3
      }
    },
    {
      "id": "operations",
      "description": "Read task notes and the existing operations documentation, then update the documentation. Write is granted as the least necessary mutation; append is omitted because the operator did not specify that append-only behavior is required.",
      "grants": [
        {
          "resource": "notes",
          "actions": [
            "read"
          ]
        },
        {
          "resource": "ops",
          "actions": [
            "read",
            "write"
          ]
        }
      ],
      "escalation": {
        "warn_at": 1,
        "stop_at": 3
      }
    }
  ]
}
