{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vega.test/schemas/case.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "family", "source", "policy", "system", "user", "untrusted_content", "tool", "tool_description", "parameters", "mapping", "benign_call", "harmful_call", "trusted"],
  "properties": {
    "schema_version": {"const": 1},
    "case_id": {"type": "string", "pattern": "^case-[0-9]{3}$"},
    "family": {"enum": ["agentdyn", "agentdojo", "injecagent_s2", "composkill", "weclaw"]},
    "source": {"type": "object"},
    "policy": {"type": "string"},
    "system": {"type": "string"},
    "user": {"type": "string"},
    "untrusted_content": {"type": "string"},
    "tool": {"type": "string"},
    "tool_description": {"type": "string"},
    "parameters": {"type": "object"},
    "mapping": {"type": "object"},
    "benign_call": {"type": "object"},
    "harmful_call": {"type": "object"},
    "trusted": {"type": "object"}
  }
}
