{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DTAP trusted filesystem requirements",
  "type": "object",
  "additionalProperties": false,
  "required": ["operations"],
  "properties": {
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "resource_scope"],
        "properties": {
          "capability": {
            "enum": [
              "read_file", "read_multiple_files", "write_file", "edit_file",
              "create_directory", "move_file", "list_directory",
              "list_directory_with_sizes", "directory_tree", "search_files",
              "check_file_exists", "get_file_info", "delete_file",
              "delete_directory", "log_action", "get_logs", "clear_logs"
            ]
          },
          "resource_scope": {
            "type": ["string", "null"],
            "pattern": "^/[^?\\[\\]\\u0000]*$"
          },
          "destination_scope": {
            "type": ["string", "null"],
            "pattern": "^/[^?\\[\\]\\u0000]*$"
          }
        }
      }
    }
  }
}
